# Gemini + Qdrant + Aliyun text-embedding-v4 local smoke config.
#
# Copy to an ignored local file before filling secrets:
#   Copy-Item samples/env/gemini-qdrant-aliyun.env.sample .env.gemini-qdrant-aliyun.local
#
# Do not commit the copied local file.

# HTTP runtime
ROLEPLAY_HOST=127.0.0.1
ROLEPLAY_PORT=8000
ROLEPLAY_API_KEY=change-me-local-admin-key
ENABLE_DEBUG_TRACE=true
AGENT_CONTEXT_PLANNER=deterministic
BACKEND_CONTEXT_PROVIDER=none
BACKEND_CONTEXT_SOURCES=
BACKEND_CONTEXT_ALLOWED_SOURCES=user_profile,game_state

# Local session persistence
SESSION_PROVIDER=sqlite
SESSION_SQLITE_PATH=.data/gemini-qdrant-aliyun-sessions.sqlite3
SESSION_SQLITE_BUSY_TIMEOUT_MS=5000
SESSION_RECENT_LIMIT=12
SESSION_TTL_SECONDS=604800
SESSION_AUTO_CREATE_SCHEMA=true

# LLM: Gemini OpenAI-compatible API
LLM_API_TYPE=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=replace-with-gemini-api-key
MODEL_TIMEOUT_MS=120000

# Embedding: Aliyun DashScope OpenAI-compatible API
# If your DashScope endpoint or region differs, change EMBEDDING_BASE_URL.
# Keep EMBEDDING_DIMENSIONS equal to the actual text-embedding-v4 output size
# and to the Qdrant collection vector size.
EMBEDDING_API_TYPE=openai_compatible
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=replace-with-dashscope-api-key
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_MS=60000

# RAG: Qdrant
# Use a test collection first. Create the collection with vector size 1024,
# or set QDRANT_ENSURE_COLLECTION=true for the first run with a new collection.
RAG_API_TYPE=qdrant
RAG_BASE_URL=https://your-qdrant-endpoint.example
RAG_INDEX=haruhi_roleplay_smoke
RAG_API_KEY=replace-with-qdrant-api-key
RAG_CHUNK_SIZE=320
QDRANT_TIMEOUT_MS=20000
QDRANT_ENSURE_COLLECTION=false

# Keep memory in-process for this smoke. Session history is persisted by SQLite.
