# Haruhi Roleplay API local environment template.
# Copy this file to `.env` for local development.
#
# Do not put real production secrets in this template.

# HTTP runtime
ROLEPLAY_HOST=127.0.0.1
ROLEPLAY_PORT=8000
ROLEPLAY_API_KEY=change-me-local-admin-key
ENABLE_DEBUG_TRACE=true
ACCESS_TOKEN_SQLITE_PATH=.data/access-tokens.sqlite3
AGENT_CONTEXT_PLANNER=deterministic
BACKEND_CONTEXT_PROVIDER=none
BACKEND_CONTEXT_SOURCES=
BACKEND_CONTEXT_ALLOWED_SOURCES=user_profile,game_state
SESSION_PROVIDER=memory
SESSION_RECENT_LIMIT=12
SESSION_TTL_SECONDS=604800
SESSION_AUTO_CREATE_SCHEMA=true

# SQLite session persistence example.
# `.data/` is ignored by git.
#
# SESSION_PROVIDER=sqlite
# SESSION_SQLITE_PATH=.data/sessions.sqlite3
# SESSION_SQLITE_BUSY_TIMEOUT_MS=5000

# PostgreSQL session persistence example.
# Requires optional runtime dependency: uv run --with "psycopg[binary]" ...
# Keep DATABASE_URL only in local `.env` or deployment secrets.
#
# SESSION_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/haruhi_roleplay
# SESSION_POSTGRES_SCHEMA=public
# SESSION_POSTGRES_TABLE_PREFIX=roleplay_

# Minimal local backend: fake model + local text RAG.
# This is the safest default for API and frontend integration tests.
MODEL_PROVIDER=fake
MODEL_NAME=fake-roleplay-model
MODEL_ALIAS=fake-roleplay-model
MODEL_TIMEOUT_MS=60000
RAG_PROVIDER=local
RAG_CHUNK_SIZE=320
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=384

# Tavern-style single backend config.
# Prefer this shape when you only need one LLM, one embedding provider, and one RAG provider.
# These fields override the legacy single-provider defaults above, unless MODEL_PROVIDER_REGISTRY is set.
#
# LLM_API_TYPE=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=replace-with-local-secret
#
# EMBEDDING_API_TYPE=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=replace-with-local-secret
#
# RAG_API_TYPE=qdrant
# RAG_BASE_URL=https://your-qdrant.example
# RAG_INDEX=haruhi_rag
# RAG_API_KEY=replace-with-local-secret

# Reserved model-backed planner entry.
# This mode is exposed as a config entry but is not implemented yet.
# AGENT_CONTEXT_PLANNER=model

# Backend context fake provider example.
# This is service-side context selection; do not expose source selection to normal users.
#
# BACKEND_CONTEXT_PROVIDER=fake
# BACKEND_CONTEXT_SOURCES=user_profile,game_state

# Ollama local model example.
# Uncomment this block and comment out MODEL_PROVIDER / MODEL_NAME /
# MODEL_ALIAS above if you want real local model replies.
#
# MODEL_PROVIDER_REGISTRY={"default_alias":"haruhi-ollama","providers":{"ollama-local":{"type":"ollama","base_url":"http://localhost:11434/v1","timeout_ms":180000}},"aliases":{"haruhi-ollama":{"provider":"ollama-local","model":"qwen2.5:7b"}}}
# RAG_PROVIDER=local_vector
# RAG_VECTOR_BACKEND=memory
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text:latest
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_TIMEOUT_MS=60000

# Chroma local vector store example.
# Requires: uv run --with chromadb ...
#
# RAG_PROVIDER=chroma
# CHROMA_COLLECTION=haruhi_rag
# CHROMA_PERSIST_PATH=.chroma

# Cloud provider secret placeholders.
# Keep real values only in local `.env` or deployment secrets.
#
# OPENAI_API_KEY=replace-with-local-secret
# DEEPSEEK_API_KEY=replace-with-local-secret
# GEMINI_API_KEY=replace-with-local-secret
# QDRANT_API_KEY=replace-with-local-secret
