# Replace before startup. Public binds reject placeholders and keys shorter than 32 characters.
ROLEPLAY_API_KEY=change-me
ROLEPLAY_PORT=8000
ROLEPLAY_CORS_ORIGINS=
ENABLE_DEBUG_TRACE=true
ACCESS_TOKEN_SQLITE_PATH=.data/access-tokens.sqlite3

SESSION_PROVIDER=sqlite
SESSION_SQLITE_PATH=.data/sessions.sqlite3
SESSION_RECENT_LIMIT=12

MEMORY_PROVIDER=sqlite
MEMORY_SQLITE_PATH=.data/memories.sqlite3

LLM_API_TYPE=fake
LLM_MODEL=fake-roleplay-model

RAG_PROVIDER=local
RAG_CHUNK_SIZE=700
# 生成文件位于宿主机 .data 后，可通过已挂载的 /app/.data 在容器内读取。
# RAG_BOOTSTRAP_CORPUS_PATH=.data/rag-corpus/haruhi/records.jsonl
# RAG_BOOTSTRAP_APP_ID=web-demo

AGENT_CONTEXT_PLANNER=deterministic
